# Legacy rollback reference only. The active Spring stack reads the repository-root .env.
# Do not commit secrets. POSTGRES_PASSWORD must match META_DATABASE_URL.

OPS_TOKEN=change-me-long-random
API_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com
GOOGLE_DESKTOP_CLIENT_ID=497109317936-vq9miqm7uib002q94hthnl04652rau58.apps.googleusercontent.com
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=revealz-backend
AUTH_JWT_AUDIENCE=revealz-windows
LOBBY_HTTP_PORT=8080
LOBBY_PUBLIC_HOST=127.0.0.1
WARM_POOL_SIZE=0

POSTGRES_DB=revealz_meta
POSTGRES_USER=revealz_meta
POSTGRES_PASSWORD=change-me

META_DATABASE_URL=postgres://revealz_meta:change-me@127.0.0.1:5432/revealz_meta
# Spring JDBC uses the same database and credentials during the BE07 transition.
CATALOG_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/revealz_meta
CATALOG_DATABASE_USERNAME=revealz_meta
CATALOG_DATABASE_PASSWORD=change-me
CATALOG_CACHE_ENABLED=true
CATALOG_CACHE_HOST=127.0.0.1
# Dedicated worker → lobby Meta (validate-deck). Same host as LOBBY_HTTP_PORT in local/docker.
META_LOBBY_URL=http://127.0.0.1:8080
# Final Dedicated match-log request limits/credential grace/retention sweep.
MATCH_LOG_MAX_BYTES=8388608
MATCH_LOG_CREDENTIAL_GRACE_MS=300000
MATCH_LOG_PRUNE_INTERVAL_MS=21600000
# Client Godot: ProjectSettings revealz/lobby_base_url, or META_LOBBY_URL when headless.
# Shop prices/pools live in Postgres shop_products (ops/db); not in this env file.

WORKER_BIN=/app/export/revealz_server
PG_DUMP=pg_dump
PG_RESTORE=pg_restore
