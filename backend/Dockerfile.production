FROM eclipse-temurin:21-jdk-noble AS build
WORKDIR /workspace/backend
COPY backend/ .
RUN chmod +x mvnw && ./mvnw --batch-mode --no-transfer-progress package -DskipTests

FROM eclipse-temurin:21-jre-noble
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl postgresql-client-16 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /workspace/backend/target/catalog-backend-0.1.0-SNAPSHOT.jar app.jar
COPY resources/cards /app/resources/cards
COPY backend/db /app/db
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
